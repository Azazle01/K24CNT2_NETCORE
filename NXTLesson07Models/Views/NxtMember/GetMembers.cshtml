
@{

    ViewData["Title"] = "Danh sách thành viên ";
    int num = 0;
}
<div class="card">
<h1>@ViewData["Title"]</h1>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#No.</th>
            <th>Member Id</th>
            <th>User Name</th>
            <th>Full Name</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in ViewBag.Members )
            {
                num++;
                <tr>
                    <td>@num</td>
                    <td>@member.NxtMemberId</td>
                    <td>@member.NxtUserName</td>
                    <td>@member.NxtFullName</td>
                    <td>@member.NxtEmail</td>
                </tr>
            }
        </tbody>
</table>
</div>