@model IEnumerable<BaiLab.Models.Product>

<div class="mt-5">
    <div class="bg-primary text-white p-2 mb-3">
        <h4 class="m-0">Sản phẩm HOT </h4>
    </div>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: contain; padding: 10px;">
                    <div class="card-body text-center">
                        <h6 class="card-title">@item.Name</h6>
                        <p class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>