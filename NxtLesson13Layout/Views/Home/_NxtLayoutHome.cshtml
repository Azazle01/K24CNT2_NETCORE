<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/NxtLayoutHome.css" asp-append-version="true" />
     <link rel="stylesheet" href="~/NxtLesson13Layout.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="container border my-1 p-2">
        <a href="/Products/Index" title="Danh sách sản phẩm ">Danh sách sản phẩm </a>
        <a asp-action="Search" asp-controller="Products">Tìm kiếm sán phẩm </a>
        <a asp-action="Hots" asp-controller="Products">Sản phảm bán chạy </a>
        <a href="/Products/About">Giới thiệu </a>
    </nav>
    <div class="container border my-1 p-2 main">
        @RenderBody()
    </div>
    <footer>
        <p style="text-align:center">&copy; 2026 -
            Copyright by @@Xuân Trường 
            <br/>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </p>
    </footer>
    <script src="~/js/NxtLayoutHome.js" asp-append-version="true"></script>
</body>
</html>
