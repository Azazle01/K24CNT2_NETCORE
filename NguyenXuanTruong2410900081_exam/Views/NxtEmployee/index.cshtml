@model IEnumerable<NguyenXuanTruong2410900081_exam.Models.NxtEmployee>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h1>Danh sách sinh viên </h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NxtName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NxtGender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NxtBirthday)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NxtEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NxtPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NxtActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NxtName)
            </td>
            <td>
                @Html.DisplayFor(model => item.NxtGender)
            </td>
            <td>
                @Html.DisplayFor(model => item.NxtBirthday)
            </td>
            <td>
                @Html.DisplayFor(model => item.NxtEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.NxtPhone)
            </td>
            <td>
                @Html.DisplayFor(model => item.NxtActive)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
